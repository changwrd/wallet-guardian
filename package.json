{
  "name": "wallet-guardian",
  "version": "0.1.0",
  "description": "A wallet guardian that learns your payment habits on Walrus Memory and checks addresses through Tatum (Total Recall hackathon).",
  "type": "module",
  "scripts": {
    "demo": "node src/demo.js",
    "check": "node src/cli.js",
    "test": "node --test test/guardian.test.js",
