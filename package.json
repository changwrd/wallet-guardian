    "demo:live": "node --env-file=.env src/demo.js",
    "check:live": "node --env-file=.env src/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@grpc/grpc-js": "^1.14.7",
    "@grpc/proto-loader": "^0.8.1",
    "@mysten-incubation/memwal": "latest"
  }
}
